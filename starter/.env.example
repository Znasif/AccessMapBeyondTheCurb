# Copy to .env for local development. For GitHub Pages, set the same names as
# repository secrets (Settings > Secrets and variables > Actions).
#
# WARNING: Vite inlines every VITE_* value into the shipped JavaScript. On a
# public Pages site these are readable by anyone who opens devtools. Repository
# secrets keep them out of the repo, not out of the bundle.

# Mapbox public tokens (pk.*) are designed for client-side use and are read-only.
# Restrict yours by URL at https://account.mapbox.com/access-tokens/ — note the
# account's DEFAULT public token cannot take URL restrictions, so generate a new one.
VITE_MAPBOX_TOKEN=

# Audiom. These end up in the embed iframe's query string, so they are visible
# in the DOM regardless of hosting — ask Audiom for a domain-restricted key.
VITE_AUDIOM_KEY=
VITE_AUDIOM_EMBED_URL=
# VITE_AUDIOM_FULL_ACCESS_KEY=   # do not deploy this to a public site
# VITE_AUDIOM_ORIGIN=

# Serve over HTTPS locally so getUserMedia works on other devices on the LAN:
#   npm i -D @vitejs/plugin-basic-ssl && VITE_HTTPS=1 npm run dev
# http://localhost is already a secure context and needs none of this.
